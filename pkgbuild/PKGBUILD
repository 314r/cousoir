# Builds Cousoir from this working tree and packages it for Arch and Omarchy:
#   make package          the package, in pkgbuild/
#   make package-install  the same, installed with pacman (asks for sudo)
pkgname=cousoir
pkgver=0.1.0
pkgrel=1
pkgdesc='Browse, edit and read your Calibre ebook library, and send books to a Kobo or a Kindle'
arch=('x86_64' 'aarch64')
url='https://github.com/314r/cousoir'
license=('GPL-3.0-only')
depends=('qt6-base' 'qt6-declarative' 'qt6-svg' 'qt6-wayland' 'qt6-webengine' 'qt6-speech'
         'sqlite' 'libzip' 'icu' 'libstemmer' 'xxhash' 'libmtp')
makedepends=('cmake' 'gcc' 'make')
optdepends=('calibre: conversions from other formats, its metadata sources and device drivers'
            'xdg-desktop-portal: the desktop file chooser'
            'speech-dispatcher: voices to read books aloud')
source=()
sha256sums=()

# In a build folder of its own, without the tests: the package is made of
# what it is built from, not of what a day's work left in build/.
build() {
  make -C "$startdir/.." app BUILD_DIR=build/package CMAKE_FLAGS=-DBUILD_TESTING=OFF
}

package() {
  DESTDIR="$pkgdir" cmake --install "$startdir/../build/package" --prefix /usr
  install -Dm644 "$startdir/../LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
