#!/usr/bin/env python3
# Stands in for calibre-debug in the tests of sending to a reader: run as
# Reliure runs Calibre's job, "-e send.py -- <job folder>", it reports
# progress and writes what the job writes, after RELIURE_FAKE_DELAY seconds
# if set. For a Kobo, each book as "Author/Title - Author.kepub.epub" in the
# job's device folder, its entry in metadata.calibre and driveinfo.calibre;
# for a Kindle, the same as operations to do, the book as
# "documents/Title - Author.azw3".
import json
import os
import sqlite3
import sys
import time

folder = sys.argv[-1]
with open(os.path.join(folder, 'job.json'), encoding='utf-8') as f:
    job = json.load(f)
device = os.path.join(folder, 'device')
kindle = 'objects' in job
os.makedirs(device, exist_ok=True)
print(json.dumps({'progress': 0.5}), flush=True)
if os.environ.get('RELIURE_FAKE_DELAY'):
    time.sleep(float(os.environ['RELIURE_FAKE_DELAY']))

con = sqlite3.connect(os.path.join(folder, 'library', 'metadata.db'))
try:
    with open(os.path.join(device, 'metadata.calibre'), encoding='utf-8') as f:
        books = json.load(f)
except FileNotFoundError:
    books = []
sent, files = [], []
for book_id in job['books']:
    title, uuid, author_sort = con.execute('SELECT title, uuid, author_sort FROM books WHERE id = ?', (book_id,)).fetchone()
    authors = [name.replace('|', ',') for (name,) in con.execute(
        'SELECT name FROM authors JOIN books_authors_link ON author = authors.id WHERE book = ? ORDER BY books_authors_link.id',
        (book_id,))]
    if kindle:
        lpath = f'documents/{title} - {" & ".join(authors)}.azw3'
        path = os.path.join(device, f'put-{len(files)}')
    else:
        lpath = f'{author_sort}/{title} - {" & ".join(authors)}.kepub.epub'
        path = os.path.join(device, lpath)
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, 'w', encoding='utf-8') as f:
        f.write(f'sent {title}')
    entry_lpath = lpath.lower() if kindle else lpath
    books = [b for b in books if b['lpath'] != entry_lpath] + [{
        'lpath': entry_lpath, 'title': title, 'authors': authors, 'author_sort': author_sort, 'uuid': uuid,
        'application_id': book_id, 'size': os.path.getsize(path), 'mime': None, 'thumbnail': None}]
    sent.append({'book': book_id, 'lpath': lpath})
    files.append((lpath, os.path.relpath(path, folder)))
with open(os.path.join(device, 'metadata.calibre'), 'w', encoding='utf-8') as f:
    json.dump(books, f, indent=2)
with open(os.path.join(device, 'driveinfo.calibre'), 'w', encoding='utf-8') as f:
    json.dump({'device_name': 'Kindle' if kindle else 'Kobo eReader', 'location_code': 'main'}, f)
with open(os.path.join(folder, 'result.json'), 'w', encoding='utf-8') as f:
    if kindle:
        json.dump({'sent': sent, 'unsendable': [], 'operations': [
            {'op': 'put', 'path': lpath, 'file': local} for lpath, local in files] + [
            {'op': 'put', 'path': name, 'file': f'device/{name}'} for name in ('driveinfo.calibre', 'metadata.calibre')]}, f)
    else:
        json.dump({'sent': sent, 'unsendable': [], 'files': [lpath for lpath, _ in files] + [
            'driveinfo.calibre', 'metadata.calibre'], 'clear_covers': True}, f)
print(json.dumps({'progress': 1.0}), flush=True)
