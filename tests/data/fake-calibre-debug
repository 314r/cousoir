#!/bin/sh
# Stands in for calibre-debug in the tests. Run as Cousoir runs Calibre's
# jobs, "-e <job>.py -- <job folder>": a conversion reports progress and
# writes what the job writes; a metadata download writes the books of
# download/identified.json, or covers made of edits/large.jpg as
# single_covers() saves them, failing as it does on a cover saved already.
# After COUSOIR_FAKE_DELAY seconds if set; COUSOIR_FAKE_FAIL makes a
# download fail with its log, COUSOIR_FAKE_FAIL_COVERS the covers after the
# first, and COUSOIR_FAKE_IGNORE names fields Calibre is set to leave aside,
# "tags" or "publisher".
folder="$4"
data=$(dirname "$(readlink -f "$0")")
case "$2" in
*/download.py)
    [ -n "$COUSOIR_FAKE_DELAY" ] && sleep "$COUSOIR_FAKE_DELAY"
    if [ -n "$COUSOIR_FAKE_FAIL" ]; then
        echo "Sources unreachable" > "$folder/log.txt"
        exit 1
    fi
    if grep -q '"kind": "covers"' "$folder/job.json"; then
        mkdir -p "$folder/covers"
        for name in "Google,,1200,,1800,,jpeg" "Amazon.com{0},,300,,450,,jpeg"; do
            cp "$data/edits/large.jpg" "$folder/covers/$name.cover"
            mkdir "$folder/covers/$name.cover.done" || exit 1
            if [ -n "$COUSOIR_FAKE_FAIL_COVERS" ]; then
                echo "Covers unreachable" > "$folder/log.txt"
                exit 1
            fi
        done
        printf '{"covers": true}' > "$folder/result.json"
    else
        sed "s/\"ignore_fields\": \[\]/\"ignore_fields\": [\"$COUSOIR_FAKE_IGNORE\"]/" \
            "$data/download/identified.json" > "$folder/result.json"
    fi
    exit 0
    ;;
esac
format=$(sed -n 's/.*"format": "\([a-z0-9]*\)".*/\1/p' "$folder/job.json" | head -n 1)
echo '{"progress": 0.5}'
[ -n "$COUSOIR_FAKE_DELAY" ] && sleep "$COUSOIR_FAKE_DELAY"
printf 'converted to %s' "$format" > "$folder/output.$format"
printf '{"input": "epub", "file": "output.%s", "save_original": false, "options": "%s"}' \
    "$format" "$(printf '\200\002T\007\000\000\000json:{}.' | base64)" > "$folder/result.json"
echo '{"progress": 1.0}'
