[Desktop Entry]
Type=Application
Name=Cousoir
Comment=Browse your Calibre ebook library
Comment[fr]=Parcourez votre bibliothèque de livres numériques Calibre
Exec=cousoir %F
MimeType=application/epub+zip;application/x-mobipocket-ebook;application/vnd.amazon.ebook;application/vnd.amazon.mobi8-ebook;
Actions=add;
Icon=io.github._314r.cousoir
Terminal=false
Categories=Office;Viewer;
Keywords=ebook;calibre;library;epub;kobo;kindle;
Keywords[fr]=livre numérique;ebook;calibre;bibliothèque;epub;kobo;kindle;liseuse;
StartupNotify=true
StartupWMClass=cousoir

[Desktop Action add]
Name=Add books
Name[fr]=Ajouter des livres
Exec=cousoir --add
